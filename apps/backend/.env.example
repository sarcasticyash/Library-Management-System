# ==============================================================================
# LMS Backend Environment Variables Template (.env.example)
# Note: Never commit real production secrets or credentials to source control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=3000

# CORS Allowed Origin (Default: Vite local development port)
CORS_ORIGIN=http://localhost:5173

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# MongoDB Atlas / Local Replica Set Connection String
# Example: mongodb://localhost:27017/lms_db?replicaSet=rs0
MONGODB_URI=mongodb://localhost:27017/lms_db

# JWT Access Token Secret (Minimum 32 characters in production)
JWT_SECRET=dev_jwt_secret_must_be_at_least_32_characters_long_for_security

# JWT Access Token Lifetime
JWT_EXPIRES_IN=15m

# JWT Refresh Token Secret
JWT_REFRESH_SECRET=dev_refresh_secret_must_be_at_least_32_chars_long

# JWT Refresh Token Lifetime
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing Work Factor (bcrypt >= 12)
BCRYPT_SALT_ROUNDS=12

