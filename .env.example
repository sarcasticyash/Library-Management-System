# ==============================================================================
# Cloud-Native Library Management System (LMS) - Root Environment Configuration
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=production

# Backend Server Port
PORT=3000

# Database Persistence (MongoDB Connection URI)
MONGODB_URI=mongodb://mongo:27017/lms_db

# Cross-Origin Resource Sharing (comma-delimited origins or single origin)
CORS_ORIGIN=http://localhost,http://localhost:80,http://localhost:5173

# Logging Level ('error' | 'warn' | 'info' | 'http' | 'debug')
LOG_LEVEL=info

# JWT Access Token Configuration (Minimum 32 characters for security)
JWT_SECRET=production_jwt_secret_must_be_configured_securely_32_chars
JWT_EXPIRES_IN=15m

# JWT Refresh Token Configuration (Minimum 32 characters for security)
JWT_REFRESH_SECRET=production_jwt_refresh_secret_must_be_configured_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing Work Factor (bcrypt >= 12)
BCRYPT_SALT_ROUNDS=12

# Frontend Base API URL (e.g. '/api/v1' for reverse proxy, or 'http://localhost:3000/api/v1')
VITE_API_BASE_URL=/api/v1
